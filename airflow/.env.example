# Airflow and Postgres. Do not commit airflow/.env. AIRFLOW_API_USER and
# AIRFLOW_API_PASSWORD come from Supabase Vault when you run `make airflow-up`.
# They can be overridden from the repository-root .env for local development.
POSTGRES_PW=<insert-your-password-here>
POSTGRES_ADMIN=<insert-your-adminname-here>
POSTGRES_DB=<name_of_metadat-databank>
FERNET_KEY=<created_fernet_key>
