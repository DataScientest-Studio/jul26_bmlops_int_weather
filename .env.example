# Local bootstrap only. Do not commit .env.
# S3 keys, API basic auth, and the Postgres URI for schema migrations live in Vault:
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, API_AUTH_USER, API_AUTH_PASSWORD
#   SUPABASE_DB_URL  (direct or session-mode, port 5432 — not transaction 6543)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<supabase-secret-key>
AIRFLOW_API_USER=<airflow-admin-name>
AIRFLOW_API_PASSWORD=<airflow-admin-password>
GF_SECURITY_ADMIN_USER=<grafana-admin-name>
GF_SECURITY_ADMIN_PASSWORD=<grafana-admin-password>